DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-production-secret-key
ALLOWED_HOSTS=dust.vmv-lab.com
CSRF_EXTRA_ORIGIN=https://dust.vmv-lab.com
CORS_EXTRA_ORIGIN=https://dust.vmv-lab.com

DB_NAME=weathertodo
DB_USER=weathertodo_user
DB_PASS=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=300

PUBLIC_DATA_API_KEY=
KMA_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
LLM_ENABLED=true
LLM_PROVIDER=
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_TIMEOUT_SEC=8
APP_TEST_TOKEN=
# 개인정보 처리방침 페이지(/privacy/)에 보일 문의처(이메일 등)
PRIVACY_CONTACT=
ENABLE_MOBILE_MAP_LOG=False
AIRKOREA_REQUEST_WORKERS=4
KMA_REQUEST_WORKERS=2
KMA_FORECAST_HOURS=72
KMA_USE_STATION_ADDRESS_REGIONS=True
KMA_ULTRA_SHORT_CANDIDATES=1
REALTIME_SPIKE_RETRY_DELAY_SECONDS=600

# nginx 뒤에서 돌릴 때 1. 0이면 모든 사용자가 같은 주소로 보여 AI 하루 30번 제한을 다 같이 나눠 쓰게 된다.
TRUSTED_PROXY_COUNT=1
COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
