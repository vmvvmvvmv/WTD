{
  "expo": {
    "name": "웨더투두",
    "slug": "Dust-health-AI-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/WeatherToDoIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/WeatherToDoIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/WeatherToDoIcon.png",
        "backgroundColor": "#F4F8FC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.xkvk11.DusthealthAIMobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기준으로 가까운 지역의 날씨와 미세먼지 정보를 보여드리기 위해 위치 권한을 사용합니다."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "웨더투두 오늘",
              "description": "현재 기온, 시간대별 날씨, 미세먼지, 오늘 일정",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50dd194a-ebc6-4121-9d15-19cebf67fc91"
      }
    },
    "scheme": "weathertodo"
  }
}
